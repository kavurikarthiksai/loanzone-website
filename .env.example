# ===============================================
# LoanZone WhatsApp Notification Environment Variables
# ===============================================

# Server Port
PORT=5001

# Owner's WhatsApp Number (International format without '+' e.g., 918522923635)
OWNER_WHATSAPP_NUMBER=918522923635
VITE_OWNER_WHATSAPP_NUMBER=918522923635

# WhatsApp Business / Cloud API Credentials
# Obtain these from Meta for Developers (https://developers.facebook.com/)
# App -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
